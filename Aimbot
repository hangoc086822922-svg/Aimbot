-- ==========================================
-- HỆ THỐNG XỬ LÝ ESP (XUYÊN TƯỜNG)
-- ==========================================
local espHighlights = {}

local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local function addHighlight(char)
        if espHighlights[player] then
            espHighlights[player]:Destroy()
            espHighlights[player] = nil
        end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.Adornee = char
        highlight.FillColor = Color3.fromRGB(255, 0, 0)      -- Màu bên trong người địch (Đỏ)
        highlight.FillTransparency = 0.5                     -- Độ mờ bên trong
        highlight.OutlineColor = Color3.fromRGB(255, 255, 0) -- Màu viền (Vàng)
        highlight.OutlineTransparency = 0                    -- Viền sắc nét hiển thị qua tường
        highlight.Parent = char
        
        espHighlights[player] = highlight
    end

    player.CharacterAdded:Connect(function(char)
        if getgenv().ScriptConfig.ESPEnabled then
            addHighlight(char)
        end
    end)

    if player.Character then
        addHighlight(player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    CreateESP(p)
end

Players.PlayerAdded:Connect(function(p)
    CreateESP(p)
end)

Players.PlayerRemoving:Connect(function(p)
    if espHighlights[p] then
        espHighlights[p]:Destroy()
        espHighlights[p] = nil
    end
end)

-- Cập nhật trạng thái bật/tắt ESP liên tục
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("ESP_Highlight") then
            player.Character.ESP_Highlight.Enabled = getgenv().ScriptConfig.ESPEnabled
        end
    end
end)

-- ==========================================
-- HỆ THỐNG LỌC MỤC TIÊU CHO AIMBOT
-- ==========================================
local function GetTargetInFront()
    local closestPart = nil
    local shortestDistance = getgenv().ScriptConfig.MaxDistance

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local enemyPart = player.Character:FindFirstChild(getgenv().ScriptConfig.PartToAim)

            if enemyRoot and enemyPart then
                local distance = (myRoot.Position - enemyRoot.Position).Magnitude
                if distance <= shortestDistance then
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(enemyPart.Position)
                    
                    if onScreen then
                        local vectorScreen = Vector2.new(screenPoint.X, screenPoint.Y)
                        local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local magnitudeScreen = (vectorScreen - centerScreen).Magnitude

                        if magnitudeScreen <= (getgenv().ScriptConfig.MaxFOV * 5) then
                            shortestDistance = distance
                            closestPart = enemyPart
                        end
                    end
                end
            end
        end
    end

    return closestPart
end

-- ==========================================
-- VÒNG LẶP CHẠY AIMBOT (CHỈ AIM KHI THẤY MỤC TIÊU)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if getgenv().ScriptConfig.AimbotEnabled then
        local targetPart = GetTargetInFront()
        if targetPart then
            -- Bám chặt vào thân khi có người trước mặt
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    end
end)
